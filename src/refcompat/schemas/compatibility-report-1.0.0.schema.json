              "type": "object"
            },
            {
              "else": {
                "properties": {
                  "anchor_sequence_name": {
                    "$ref": "#/$defs/sequenceName"
                  }
                }
              },
              "if": {
                "properties": {
                  "state": {
                    "const": "proven_absent"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "properties": {
                  "anchor_sequence_name": {
                    "type": "null"
                  }
                }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/capabilityBase"
            },
            {
              "properties": {
                "sequence_names": {
                  "$ref": "#/$defs/sequenceNames"
