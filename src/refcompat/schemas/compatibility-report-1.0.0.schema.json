                "type": {
                  "const": "sequence_order"
                }
              },
              "required": [
                "type",
                "sequence_names"
              ],
              "type": "object"
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/capabilityBase"
