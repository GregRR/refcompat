          "$ref": "#/$defs/nonEmptyString"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "incomplete_operation",
            "invalid_input"
          ]
        },
        "resource_ids": {
          "$ref": "#/$defs/idArray"
        }
      },
      "required": [
        "id",
        "kind",
        "detail",
        "resource_ids"
      ],
      "type": "object"
    },
    "artifact": {
      "additionalProperties": false,
      "properties": {
