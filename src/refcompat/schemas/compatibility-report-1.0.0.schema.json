            {
              "properties": {
                "checked_count": {
                  "minimum": 0,
                  "type": "integer"
                },
                "conflict_count": {
                  "minimum": 0,
                  "type": "integer"
                },
                "representable_count": {
                  "minimum": 0,
                  "type": "integer"
                },
                "subject_resource_id": {
                  "$ref": "#/$defs/id"
                },
                "type": {
                  "const": "coordinate_bounds_validation"
                },
                "unresolved_count": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "type",
                "subject_resource_id",
                "checked_count",
                "representable_count",
                "conflict_count",
                "unresolved_count"
              ],
              "type": "object"
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/capabilityBase"
            },
            {
              "properties": {
                "checked_count": {
                  "minimum": 0,
                  "type": "integer"
                },
                "match_count": {
                  "minimum": 0,
                  "type": "integer"
                },
                "mismatch_count": {
                  "minimum": 0,
                  "type": "integer"
                },
                "subject_resource_id": {
                  "$ref": "#/$defs/id"
                },
                "type": {
                  "const": "reference_base_validation"
                },
                "unresolved_count": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "type",
                "subject_resource_id",
                "checked_count",
                "match_count",
                "mismatch_count",
                "unresolved_count"
              ],
              "type": "object"
            }
          ],
          "unevaluatedProperties": false
        }
